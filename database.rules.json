{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false,
      "$uid": {
        ".validate": "newData.hasChildren(['uid','email','name','role','active']) && newData.child('uid').val() === $uid && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'super')"
      }
    },

    "mrt_tours_public": {
      ".read": true,
      ".write": false,
      "$tourId": {
        ".validate": "newData.hasChildren(['id','name','date','listings','sponsors','version']) && newData.child('id').val() === $tourId"
      }
    },
    "mrt_tours_private": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },

    "mrt_ratings_public": {
      ".read": true,
      ".write": false
    },
    "mrt_ratings_private": {
      "$tourId": {
        "$listingId": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
            ".write": false
          }
        }
      }
    },
    "mrt_rating_grants": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "mrt_favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tourId": {
          "$listingId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true || !newData.exists()"
          }
        }
      }
    },
    "mrt_favorite_counts": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },

    "mrt_listing_requests": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },
    "mrt_tour_requests": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },
    "mrt_sponsor_signups": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },
    "mrt_contact_requests": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },

    "mrt_campaigns": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },
    "mrt_suppressions": {
      ".read": "auth != null && auth.token.mrtRole === 'super'",
      ".write": false
    },
    "mrt_reminders": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false,
      ".indexOn": ["nextAttemptAt", "status"]
    },
    "mrt_invoices": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },

    "mrt_idempotency": {
      ".read": false,
      ".write": false
    },
    "mrt_rate_limits": {
      ".read": false,
      ".write": false
    },
    "mrt_webhook_events": {
      ".read": false,
      ".write": false
    },

    "mrt_tours": {
      ".read": false,
      ".write": false
    },
    "mrt_ratings": {
      ".read": false,
      ".write": false
    },
    "mrt_not_interested": {
      ".read": false,
      ".write": false
    },
    "mrt_tour_previews": {
      ".read": false,
      ".write": false
    },
    "mrt_subadmins": {
      ".read": false,
      ".write": false
    },
    "mrt_settings": {
      ".read": false,
      ".write": false
    }
  }
}
