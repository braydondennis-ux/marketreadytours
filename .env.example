# Public App Check site key for the Firebase project used by this hosted environment.
# Configure separate Vercel Preview (dev Firebase) and Production (prod Firebase) values.
# Local emulator builds do not require a key.
MRT_APP_CHECK_SITE_KEY=
# Preview currently uses v3. Production should use a score-based Enterprise key.
MRT_APP_CHECK_PROVIDER=v3

# Keep live outbound disabled by default. Only the isolated dev Functions project may set this.
MRT_ALLOW_LIVE_OUTBOUND=false
