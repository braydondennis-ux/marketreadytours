rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        (request.auth.token.mrtRole == 'admin' || request.auth.token.mrtRole == 'super');
    }

    function isImageCreateOrUpdate(maxMb) {
      return request.resource != null &&
        request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)') &&
        request.resource.size > 0 &&
        request.resource.size <= maxMb * 1024 * 1024;
    }

    match /mrt_upload_temp/{uid}/{fileId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        isImageCreateOrUpdate(10);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /mrt_rating_photos/{tourId}/{listingId}/{uid}/{fileId} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /mrt_listing_photos/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageCreateOrUpdate(10);
      allow delete: if isAdmin();
    }

    match /mrt_branding/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageCreateOrUpdate(5);
      allow delete: if isAdmin();
    }

    match /mrt_sponsor_logos/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageCreateOrUpdate(5);
      allow delete: if isAdmin();
    }

    match /mrt_sponsor_headshots/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageCreateOrUpdate(5);
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
