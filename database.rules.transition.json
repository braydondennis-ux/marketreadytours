{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'marketreadytours@gmail.com'",
      "$adminKey": {".validate": "newData.hasChild('role')"}
    },
    "mrt_subadmins": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'marketreadytours@gmail.com'"
    },
    "mrt_settings": {
      ".read": "auth != null && auth.token.email === 'marketreadytours@gmail.com'",
      ".write": "auth != null && auth.token.email === 'marketreadytours@gmail.com'"
    },

    "mrt_tours": {
      "//": "AUDIT M5 (2026-08-10) — KNOWN EXPOSURE, DELIBERATELY UNFIXED. This legacy node is world-readable and contains 33 tour access codes, 131 agentEmail and 128 agentPhone fields, and 642 distinct email addresses. It CANNOT be restricted while rollback is available: the pre-refresh build (cd6f980) performs NO authentication at all — zero signInAnonymously calls — so any auth requirement makes the rolled-back site load nothing. The refresh does not read this node; it uses mrt_tours_public, which carries none of that data. THE FIX IS TO DELETE THIS NODE once the rollback window closes, not to tighten the rule. Do not change .read to 'auth != null' — scripts/production-cutover.test.mjs:150 asserts this on purpose.",
      ".read": true,
      ".write": "auth != null",
      "$tour_index": {
        "ratings": {
          "$listing_id": {
            ".write": true,
            ".validate": "newData.hasChildren() || !newData.exists()"
          }
        },
        "favorites": {
          "$listing_id": {
            ".write": true,
            ".validate": "newData.isBoolean() || !newData.exists()"
          }
        },
        "notes": {"$listing_id": {".write": "auth != null"}}
      }
    },
    "mrt_tours_public": {".read": true, ".write": false},
    "mrt_tours_private": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },
    "mrt_tour_previews": {".read": true, ".write": "auth != null"},

    "mrt_ratings": {
      ".read": true,
      "$tourId": {"$listingId": {"$subId": {
        ".write": "auth != null || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChild('submittedAt')"
      }}}
    },
    "mrt_ratings_public": {".read": true, ".write": false},
    "mrt_ratings_private": {
      "$tourId": {"$listingId": {"$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
        ".write": false
      }}}
    },
    "mrt_rating_grants": {
      "$uid": {".read": "auth != null && auth.uid === $uid", ".write": false}
    },

    "mrt_favorites": {
      ".read": true,
      "$firstKey": {"$secondKey": {"$thirdKey": {
        ".write": true,
        ".validate": "newData.isBoolean() || !newData.exists()"
      }}}
    },
    "mrt_favorite_counts": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },

    "mrt_reminders": {".read": "auth != null", ".write": "auth != null", ".indexOn": ["nextAttemptAt"]},
    "mrt_listing_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$reqId": {
        ".write": "auth != null || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChild('id')"
      }
    },
    "mrt_tour_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$reqId": {".write": "auth != null || (!data.exists() && newData.exists())"}
    },
    "mrt_contact_requests": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },
    "mrt_sponsor_signups": {
      ".read": "auth != null",
      "$firstKey": {"$secondKey": {
        ".write": "auth != null || (!data.exists() && newData.exists())"
      }}
    },
    "mrt_campaigns": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["tourId", "status"]
    },
    "mrt_suppressions": {
      ".read": "auth != null && auth.token.mrtRole === 'super'",
      ".write": false
    },
    "mrt_not_interested": {
      ".read": "auth != null",
      "$tourId": {"$emailKey": {".write": "auth != null || (!data.exists() && newData.exists())"}}
    },
    "mrt_listing_requests_queue": {
      ".read": "auth != null",
      "$reqId": {".write": "auth != null || (!data.exists() && newData.exists())"}
    },

    "mrt_invoices": {
      ".read": "auth != null && (auth.token.mrtRole === 'admin' || auth.token.mrtRole === 'super')",
      ".write": false
    },
    "mrt_idempotency": {".read": false, ".write": false},
    "mrt_rate_limits": {".read": false, ".write": false},
    "mrt_webhook_events": {".read": false, ".write": false},
    "live_activity": {"$tour_id": {".read": true, ".write": "auth != null"}}
  }
}
